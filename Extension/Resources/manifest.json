{
    "manifest_version": 3,
    "name": "FixGHScroll",
    "description": "Stops GitHub pages from jumping to the bottom when you scroll.",
    "version": "1.0.1",
    "icons": {
        "512": "icon.png"
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/*"],
            "js": ["content.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}
